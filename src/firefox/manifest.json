{
  "manifest_version": 3,
  "name": "RABG: Add Beaten Badges to RetroAchievements",
  "version": "1.3.0",
  "description": "Shows your beaten games alongside mastered games in the Game Awards section of RetroAchievements profile pages.",
  "browser_specific_settings": {
    "gecko": {
      "id": "rabg-for-retroachievements@foss",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "48": "icons/gold.svg",
    "96": "icons/gold.svg"
  },
  "action": {
    "default_title": "RABG Settings",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/gold.svg",
      "96": "icons/gold.svg"
    }
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://retroachievements.org/*",
        "*://*.retroachievements.org/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/gold.svg",
        "icons/silver.svg"
      ],
      "matches": [
        "*://retroachievements.org/*",
        "*://*.retroachievements.org/*"
      ]
    }
  ]
}